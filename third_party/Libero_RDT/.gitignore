checkpoints/
*.bin
*.pth
*.safetensors
*.ckpt

# 训练输出和评估结果
outs/
outputs/
results/

# WandB 日志和缓存
wandb/
.wandb/

# 训练日志
logs/
*.log
nohup.out

# ============ Python 相关 ============
# 字节码和缓存
