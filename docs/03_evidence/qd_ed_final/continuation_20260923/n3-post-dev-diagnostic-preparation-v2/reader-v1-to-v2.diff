+def admit_plans(authority, base, originals, definition, inputs):
+    """Only the pinned null-to-certificate transition; no evidence recursion."""
+    contract = definition['checkpoint_admission']
+    require(authority['base_plan'] == contract['base_plan']
+            and authority.get('plan_revisions') == contract['plan_revisions'], 'named_plan_references_differ')
+    cohort = base['n3_cohort']
+    require('checkpoint_release' in cohort and cohort['checkpoint_release'] is None
+            and contract['base_checkpoint_value'] is None, 'base_checkpoint_must_be_explicit_null')
+    release = inputs.read(contract['checkpoint_release'])
+    expected = contract['release_metadata']
+    require({k: release.get(k) for k in expected} == expected, 'checkpoint_metadata_differs')
+    code_sha = sha(json.dumps(base['code_files'], sort_keys=True, separators=(',', ':')).encode())
+    require(release['schema'] == 'qd-ed-n3-checkpoint-v1'
+            and release['cohort_id'] == cohort['cohort_id'] == COHORT
+            and release['source_commit'] == base['source_commit'] == SOURCE
+            and release['source_files_sha256'] == code_sha
+            and release['protocol_sha256'] == cohort['protocol']['sha256']
+            and release['runtime_tracking_validity'] == 'known_valid'
+            and len(release['attempt_ids']) == len(set(release['attempt_ids'])) == 3
+            and release['checks'] and all(v is True for v in release['checks'].values()), 'checkpoint_source_binding_differs')
+    plans = {authority['base_plan']['sha256']: base}
+    for ref in contract['plan_revisions']:
+        plan = inputs.read(ref)
+        revision_cohort = plan['n3_cohort']
+        require('checkpoint_release' in revision_cohort
+                and revision_cohort['checkpoint_release'] == contract['checkpoint_release'], 'revision_checkpoint_reference_differs')
+        normalized = dict(revision_cohort)
+        normalized['checkpoint_release'] = None
+        require(all(plan[k] == base[k] for k in BINDING)
+                and plan['code_files'] == base['code_files'] and plan['candidate_profiles'] == base['candidate_profiles']
+                and normalized == cohort
+                and [r for r in plan['episodes'] if not r.get('retry_of')] == originals, 'revision_changes_frozen_condition')
+        plans[ref['sha256']] = plan
+    return plans
 
 
