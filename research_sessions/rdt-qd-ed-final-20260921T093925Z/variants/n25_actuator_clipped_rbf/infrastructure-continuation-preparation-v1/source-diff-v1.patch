+        e.require(row is not None,'unknown dispatched cell');e.terminal_binding(final,row,plan,result['plan'],source['commit'])
+        path=Path(final['output_dir'])/'process.json'
+        if any(x['event']=='dispatched' for x in g):
+            process=reader.json(e.ref_from_inventory(reader,path))
+            e.require(process['attempt_id']==aid,'dispatched process attempt differs')
+            proc={k:process[k] for k in ('pid','proc_start_ticks','boot_id')}
+            e.require(type(proc['pid']) is int and proc['pid']>1 and isinstance(proc['proc_start_ticks'],str)
+                and proc['proc_start_ticks'].isdigit() and isinstance(proc['boot_id'],str) and bool(proc['boot_id']),'dispatched process identity absent/malformed')
+            processes.append(proc)
+        else:
+            e.require(final['event']=='aborted' and final.get('outcome_valid') is not True,'undispatched result cannot be accepted')
+            process_absences.append({'attempt_id':aid,**e.absence(path)})
+    expected_attempts=[q['terminal'] for q in seal['all_old_attempts']]+finals
+    ids=[x['attempt_id'] for x in result['attempts']]
+    e.require(len(ids)==len(expected_attempts) and len(set(ids))==len(ids)
+        and len({x['attempt_id'] for x in expected_attempts})==len(expected_attempts),'unique exactly-once attempt count required')
+    e.require(all(x['terminal']['attempt_id']==x['attempt_id'] and x['episode_key']==x['terminal']['episode_key']
+        and x['profile']==x['terminal']['identity']['profile'] for x in result['attempts']),'attempt cost identity differs')
+    e.require({x['attempt_id']:x['terminal'] for x in result['attempts']}=={x['attempt_id']:x for x in [q['terminal'] for q in seal['all_old_attempts']]+finals},'all old/new terminal costs must be retained')
+    imported=[{**x['cell'],'logical_index':x['logical_index'],'origin':'imported_original'} for x in seal['accepted_prefix']]
+    e.require(result['accepted_cells'][:18]==imported,'imported prefix changed')
+    new=result['accepted_cells'][18:];keys=[x['episode_key'] for x in plan['episodes']]
+    e.require([x['episode_key'] for x in new]==keys[:len(new)] and len(new)<=22,'new accepted prefix differs')
+    wins={a:seal['counts'][a]['success'] for a in c.ARMS};denom={a:seal['counts'][a]['audited'] for a in c.ARMS}
+    native={a:dict(seal['native'][a]) for a in c.ARMS};aux={a:dict(seal['auxiliary'][a]) for a in c.ARMS}
+    for offset,cell in enumerate(new):
