+@pytest.mark.parametrize('fault',['nan','inf','shape','dtype','horizon','batch','adapter','projection_nonfinite','projection_shape'])
+def test_fail_closed_without_baseline_fallback(stub_steer,stub_adapter,monkeypatch,fault):
