+"""Exact, reversible evaluation-only bridge from all257 frozen N25 Dev files."""
+import hashlib
+import subprocess
+from pathlib import Path
+from scripts import qd_ed_n23_worker as w
+DEV_COMMIT='5a65ef15968cc68c82314e8c0773b3365ad45fa0'
