index 0000000000000000000000000000000000000000..98a76f6b44cbafdadf296be983e28c19fb2aef9a
--- /dev/null
+++ b/scripts/qd_ed_n32r3_bridge.py
@@ -0,0 +1,77 @@
+"""Exact new command composition with separate operational/scientific source."""
+import hashlib
+import json
+from pathlib import Path
+from scripts import qd_ed_n23_worker as w, qd_ed_n32_bridge as old
+from scripts import qd_ed_n32r3_contract as c
+
+ROOT, profiles, attest_loaded = old.ROOT, old.profiles, old.attest_loaded
+RUNTIME_SOURCES, runner = old.RUNTIME_SOURCES, old.runner
+
+
+def source_paths(root=ROOT):
+    return old.source_paths(root) | {str(p.relative_to(root)) for pattern in
+                                   ('scripts/qd_ed_n32r3_*.py', 'tests/test_n32r3*.py') for p in Path(root).glob(pattern)}
+
+
+def command(plan, runtime, row):
+    # Only the scientific runtime binding retains the original scientific commit.
+    # The manifest/worker/release separately attest the actual operational commit.
+    argv, output = old.command({**plan, 'source': plan['scientific_source']}, runtime, row)
+    candidates = c.read_ref(plan['command_candidates'])
+    matches = [x for x in candidates['commands'] if x['new_attempt_id'] == row['episode_key']]
+    w.require(len(matches) == 1, 'exact command candidate')
+    candidate = matches[0]
+    parent = c.read_ref(candidate['parent_expected_manifest'])
+    w.require(candidate['old_argv'] == parent['argv'] and len(argv) == len(parent['argv']), 'parent command anchor')
+    changes = [{'index': i, 'old': a, 'new': b} for i, (a,b) in enumerate(zip(parent['argv'], argv)) if a != b]
+    allowed = {'hydra.run.dir', 'main.eds_eval.output_dir', 'main.eds_eval.job_id',
+               'main.eds_mechanism_pretest.output_dir', 'main.eds_mechanism_pretest.run_id', 'main.eds_config.n32_runtime_binding'}
+    w.require(changes == candidate['exact_changes'] and argv == candidate['proposed_argv']
+              and str(output) == candidate['proposed_output_dir']
+              and all(x['old'].split('=',1)[0] == x['new'].split('=',1)[0] in allowed for x in changes), 'non-identity command change')
+    return argv, output
+
+
+def manifest(plan, runtime, row):
+    task = runtime['tasks'][str(row['task_id'])]
+    files = {v['path']: v['sha256'] for v in runtime['files']}
+    w.require(task['task_id'] == row['task_id'] and task['init_index'] == row['init_index']
+              and files[task['init_path']] == row['init_file_sha256'] and files[task['bddl_path']] == row['bddl_sha256'], 'runtime task hashes')
+    argv, output = command(plan, runtime, row)
+    config, resolved = old.compose_launch(argv, plan['worktree'])
+    w.require(config['backend']['libero']['max_episode_steps'] == 720
+              and config['policy']['rdt']['control_frequency'] == 20
+              and config['policy']['rdt']['action_chunk_horizon'] == 8, 'frozen episode schedule')
+    index = {x['path']: x['sha256'] for x in plan['scientific_source']['files']}
+    expected = None
+    if row['profile'] == 'N32':
+        expected = {'binding': resolved['n32_runtime_binding'],
+                    'config_sha256': hashlib.sha256(json.dumps(resolved, sort_keys=True, allow_nan=False).encode()).hexdigest(),
+                    'source_hashes': {**{name: index['core/'+name] for name in RUNTIME_SOURCES}, 'main.py': index['main.py']}}
+    result = {'schema': 'n32r3-external-runtime-v1', 'row': row, 'source': plan['source'],
+              'runtime': plan['runtime'], 'argv': argv, 'output_dir': str(output),
+              'composed_config_sha256': w.canonical_sha(config), 'resolved_config': resolved,
+              'expected_runtime': expected, 'continuation': c.commitments(plan, row)}
+    return result
+
+
+def verify_manifest(reference, plan, runtime, row):
+    w.verify_source(plan['worktree'], plan['source'])
+    w.require(source_paths(Path(plan['worktree'])) <= {v['path'] for v in plan['source']['files']}, 'complete continuation source')
+    w.require(w.read_ref(plan['runtime']) == runtime, 'runtime changed')
+    actual = w.read_ref(reference)
+    w.require(actual == json.loads(json.dumps(manifest(plan, runtime, row))), 'external manifest/config/task/source differs')
+    return actual
+
+
+def semantic_key(plan, manifest):
+    """Exact command normalization, after command() has checked bound substitutions."""
+    row = manifest['row']
+    candidates = c.read_ref(plan['command_candidates'])['commands']
+    candidate = next(x for x in candidates if x['new_attempt_id'] == row['episode_key'])
+    parent = c.read_ref(candidate['parent_expected_manifest'])
+    return w.canonical_sha({'row': {k: row[k] for k in c.SEMANTIC_FIELDS},
+                            'scientific_source': plan['scientific_source'],
+                            'parent_runtime': parent['runtime'], 'normalized_argv': parent['argv'],
+                            'normalized_config_sha256': parent['composed_config_sha256']})
diff --git a/scripts/qd_ed_n32r3_contract.py b/scripts/qd_ed_n32r3_contract.py
new file mode 100644
index 0000000000000000000000000000000000000000..c2c2729dcfc113d0151243aba29413ecf600f58e
--- /dev/null
+++ b/scripts/qd_ed_n32r3_contract.py
@@ -0,0 +1,93 @@
+"""N32R3 operational continuation, separate from the immutable N32R2 contract."""
+import datetime as dt
+from pathlib import Path
+from scripts import qd_ed_n23_worker as w, qd_ed_n32_contract as parent
+
+ROOT = parent.ROOT
+ARMS = parent.ARMS
+DEADLINE = parent.DEADLINE
+GPU_UUID = parent.GPU_UUID
+COHORT = 'N32R3_ARCHIVE_ELIGIBLE_CAPTURE_CONTINUATION_DEV_20261008'
+OLD_INVALID = 'n32r2_dev_t04_n32_20261004'
+RECOVERY = 'n32r3_recovery_t04_n32_20261008'
+BASE_SOURCE = '1065f38122379a515b60a9a424f574330405b66f'
+LIMITS = {'new_attempts': 16, 'baseline': 5, 'development': 10, 'recovery': 1,
+          'automatic_recoveries': 0, 'continuation_gpu_seconds': 30600,
+          'episode_seconds': 1800, 'cleanup_seconds': 40, 'physical_gpu': 7, 'gpu_uuid': GPU_UUID}
+WORKER_CONTRACT = {**parent.WORKER_CONTRACT, 'schema': 'n32r3-same-process-audit-v1'}
+PROMOTION = {'all_valid_cells': 30, 'n32_min_successes': 5, 'matched_controls_required': True}
+SEMANTIC_FIELDS = ('task_id', 'profile', 'split', 'seed_block', 'env_seed', 'policy_seed',
+                   'init_index', 'init_row_sha256', 'init_file_sha256', 'bddl_sha256')
+ref, finite, stop_path = parent.ref, parent.finite, parent.stop_path
+
+
+def read_ref(reference):
+    """Preparation references may additionally commit exact byte length."""
+    w.require(isinstance(reference, dict) and set(reference) in
+              ({'path', 'sha256'}, {'path', 'sha256', 'bytes'}), 'reference fields')
+    result = w.read_ref({k: reference[k] for k in ('path', 'sha256')})
+    if 'bytes' in reference:
+        w.require(type(reference['bytes']) is int and Path(reference['path']).stat().st_size == reference['bytes'], 'reference length')
+    return result
+
+
+def same_ref(a, b):
+    return all(a[k] == b[k] for k in ('path', 'sha256'))
+
+
+def expected_rows(root=ROOT):
+    rows = []
+    for old in parent.expected_rows(root)[14:]:
+        recovery = old['episode_key'] == OLD_INVALID
+        rows.append({**old, 'iteration': COHORT,
+                     'episode_key': RECOVERY if recovery else f'n32r3_dev_t{old["task_id"]:02d}_{old["profile"].lower()}_20261008',
+                     'budget_bucket': 'recovery' if recovery else old['budget_bucket']})
+    return rows
+
+
+def recovery_of(row):
+    return OLD_INVALID if row['episode_key'] == RECOVERY else None
+
+
+def require_recovery_row(plan, row):
+    w.require(plan['schema'] == 'n32r3-released-plan-v1' and plan['episodes'] == expected_rows(plan['worktree'])
+              and row == plan['episodes'][0] and row['episode_key'] == RECOVERY
+              and not row.get('retry_of'), 'exact versioned explicit recovery')
+
+
+def commitments(plan, row):
+    w.require(row in expected_rows(plan['worktree']), 'continuation row')
+    return {**{k: plan[k] for k in ('parent_plan', 'parent_release', 'parent_review', 'carry_forward_map',
+                                   'command_candidates', 'source_continuity', 'scientific_source', 'preparation_review')},
+            'semantic_row': {k: row[k] for k in SEMANTIC_FIELDS},
+            'recovery_of': recovery_of(row), 'retry_of': None}
+
+
+def require_release(_):
+    raise ValueError('N32R3 requires a separately adopted plan and detached root release')
+
+
+def pre_dispatch(row, allowance, *, now, stop_path):
+    w.require(not Path(stop_path).exists() and not Path(stop_path).is_symlink(), 'STOP pre-dispatch')
+    w.require(now.tzinfo is not None, 'timezone-aware admission time')
+    starts = dt.datetime.fromisoformat(allowance['authority_starts_at'].replace('Z', '+00:00'))
+    ends = min(dt.datetime.fromisoformat(x.replace('Z', '+00:00')) for x in (allowance['authority_ends_at'], DEADLINE))
+    w.require(starts <= now and now + dt.timedelta(seconds=1840) <= ends, 'deadline/authority full1840s unavailable')
+    w.require(row in expected_rows(), 'exact continuation identity')
+    w.require(allowance['private_budget'] is True and allowance['gpu_idle'] is True
+              and allowance['physical_gpu'] == 7 and allowance['gpu_uuid'] == GPU_UUID
+              and allowance['live_handles'] == [] and allowance['unsettled_reservations'] == 0, 'private idle settled GPU')
+    for key in ('global_seconds_remaining', 'private_seconds_remaining', 'cohort_seconds_remaining'):
+        w.require(finite(allowance[key], key) >= 1840, key + ' insufficient')
+    w.require(allowance['cohort_seconds_remaining'] <= 30600, 'continuation seconds ceiling')
+    w.require(allowance['global_seconds_remaining'] - finite(allowance['protected_seconds_remaining'], 'protected seconds') >= 1840, 'protected seconds')
+    for key in ('global_attempts_remaining', 'cohort_attempts_remaining', 'protected_attempts_remaining'):
+        w.require(type(allowance[key]) is int and allowance[key] >= 0, 'unknown attempt balance')
+    w.require(1 <= allowance['cohort_attempts_remaining'] <= 16 and
+              allowance['global_attempts_remaining'] - allowance['protected_attempts_remaining'] >= 1, 'attempt reserve/cap')
+    bucket = row['budget_bucket']
+    for field in ('bucket_attempts_remaining', 'local_bucket_attempts_remaining'):
+        value = allowance[field][bucket]
+        w.require(type(value) is int and value >= 1, 'bucket exhausted/unknown')
+    w.require(allowance['local_bucket_attempts_remaining'][bucket] <= LIMITS[bucket], 'local bucket cap')
+    return 1840
diff --git a/scripts/qd_ed_n32r3_history.py b/scripts/qd_ed_n32r3_history.py
new file mode 100644
index 0000000000000000000000000000000000000000..fb604793fc6f512a40cedee6eb4e2455f7e4b9d9
--- /dev/null
+++ b/scripts/qd_ed_n32r3_history.py
@@ -0,0 +1,146 @@
+"""Bounded original metadata verification; never relabel receipts or replay tensors.
+
+Trust terminates at the caller's detached root release, which commits the exact
+preparation map and the independently reviewed original receipt closure.
+"""
+from pathlib import Path
+from scripts import qd_ed_n23_worker as w, qd_ed_n32_contract as old
+from scripts import qd_ed_n32_supervise as old_supervisor, qd_ed_n32_release as old_release
+from scripts import qd_ed_n32r3_contract as c
+
+
+def validate_mapping(plan):
+    mapping = c.read_ref(plan['carry_forward_map'])
+    verify_preparation_anchor(plan)
+    parent = c.read_ref(plan['parent_plan'])
+    old_release.validate_plan(parent)  # Original schema/matrix contract, unchanged.
+    w.require(c.same_ref(mapping['parent_plan'], plan['parent_plan'])
+              and parent['source'] == plan['scientific_source']
+              and parent['source']['commit'] == c.BASE_SOURCE, 'immutable parent/source')
+    released = c.read_ref(plan['parent_release'])
+    expected = {'schema': 'n32-execution-release-v1', 'approved': True, 'plan': plan['parent_plan'],
+                **{k: parent[k] for k in ('authority', 'protocol', 'source', 'runtime', 'limits', 'phase_authorization')}}
+    w.require(released == {**expected, 'root_review': plan['parent_review']}, 'original detached release')
+    w.require(c.read_ref(plan['parent_review']) == {**expected, 'schema': 'n32-root-production-review-v1', 'decision': 'APPROVED'}, 'original root review')
+    evidence = c.read_ref(mapping['continuity_evidence'])
+    w.require(c.same_ref(evidence['inputs']['plan.frozen.v1.json'], plan['parent_plan'])
+              and c.same_ref(evidence['inputs']['execution-release-v1.json'], plan['parent_release'])
+              and c.same_ref(evidence['inputs']['root-production-review-v1.json'], plan['parent_review']), 'parent evidence commitments')
+    c.read_ref(mapping['terminal_review'])
+    w.require(mapping['schema'] == 'n32r3-carry-forward-map-v1' and mapping['continuity_failures'] == []
+              and mapping['release_enabled'] is False and mapping['pooling_authorized'] is False
+              and mapping['command_candidates'] == plan['command_candidates'], 'immutable preparation map')
+    accepted, proposed = mapping['accepted_cells'], mapping['proposed_cells']
+    w.require(len(accepted) == 14 and len(proposed) == 16, '14+16 exact map')
+    for entry, row in zip(accepted, parent['episodes'][:14]):
+        w.require(entry['original_row'] == row and
+                  entry['old_attempt_id'] == entry['new_attempt_id'] == entry['attempt_id'] == row['episode_key']
+                  and entry['semantic_cell'] == {k: row[k] for k in c.SEMANTIC_FIELDS}
+                  and entry['expected_manifest'] == parent['expected_manifests'][row['episode_key']]
+                  and entry['source_commit'] == c.BASE_SOURCE and entry['runtime'] == parent['runtime']
+                  and entry['denominator_eligible'] is True and entry['replay_permitted'] is False, 'carry-forward identity')
+    invalid = mapping['old_invalid_cell']
+    w.require(invalid['original_row'] == parent['episodes'][14] and invalid['attempt_id'] == c.OLD_INVALID
+              and invalid['denominator_eligible'] is False and invalid['new_attempt_id'] is None
+              and invalid['proposed_recovery_attempt_id'] == c.RECOVERY, 'unique invalid linkage')
+    for entry, old_row, row in zip(proposed, parent['episodes'][14:], c.expected_rows(plan['worktree'])):
+        w.require(entry['old_row'] == old_row and entry['proposed_row'] == row
+                  and entry['old_attempt_id'] == old_row['episode_key'] and entry['new_attempt_id'] == row['episode_key']
+                  and entry['semantic_continuity'] == {k: v for k, v in old_row.items() if k not in ('iteration', 'episode_key', 'budget_bucket')}
+                  and entry['parent_expected_manifest'] == parent['expected_manifests'][old_row['episode_key']]
+                  and entry['recovery_of'] == c.recovery_of(row) and entry['retry_of'] is None
+                  and entry['native_receipt'] is None and entry['generic_audit'] is None
+                  and entry['release_enabled'] is False, 'proposed semantic/execution identity')
+    return mapping, parent
+
+
+def verify_cell(entry, plan, parent, *, valid=True):
+    """Verify exact reviewed metadata bytes and their cross-artifact identities.
+
+    This is deliberately not a replacement native/generic audit. Original audit
+    evidence remains committed by the original receipts and root review.
+    """
+    data = {k: c.read_ref(entry[k]) for k in ('terminal_receipt', 'native_receipt', 'generic_audit',
+                                            'context', 'command_receipt', 'process_receipt', 'expected_manifest')}
+    stage = entry['stage_events']
+    path = Path(stage['path'])
+    w.require(path.is_file() and not path.is_symlink() and w.sha(path) == stage['sha256']
+              and path.stat().st_size == stage['bytes'], 'Stage metadata digest')
+    terminal, native, context, process, manifest = (data[k] for k in ('terminal_receipt', 'native_receipt', 'context', 'process_receipt', 'expected_manifest'))
+    row = entry['original_row']; key = row['episode_key']
+    output = Path(manifest['output_dir'])
+    paths = {'terminal_receipt': 'attempt-result.json', 'native_receipt': 'eds_eval/n32-worker-receipt.json',
+             'generic_audit': 'eds_eval/decision-evidence-audit.json', 'context': 'n32-worker-context.json',
+             'command_receipt': 'command.json', 'process_receipt': 'process.json', 'stage_events': 'eds_eval/stage_events.jsonl'}
+    w.require(all(entry[k]['path'] == str(output / v) for k,v in paths.items()), 'original receipt paths')
+    w.require(context == {'schema': 'n32-worker-context-v1', 'plan': plan['parent_plan'],
+              'release': plan['parent_release'], 'expected_manifest': entry['expected_manifest'],
+              'episode_key': key, 'attempt_id': key, 'main_argv': manifest['argv'][1:], 'worker_contract': old.WORKER_CONTRACT}, 'original context binding')
+    w.require(manifest['row'] == row and manifest['source'] == parent['source'] and manifest['runtime'] == parent['runtime'], 'original manifest identity')
+    w.require(process['attempt_id'] == key and process['context'] == entry['context'] and process['release'] == plan['parent_release'], 'original process binding')
+    identity = {k: process[k] for k in ('pid', 'proc_start_ticks', 'boot_id')}
+    w.require(native['process'] == identity and native['context'] == entry['context'] and native['plan'] == plan['parent_plan']
+              and native['row'] == row and native['source'] == parent['source'] and native['expected_manifest'] == entry['expected_manifest']
+              and native['attempt_id'] == key and c.same_ref(native['audit_report'], entry['generic_audit'])
+              and native['native_counts'] == entry['native_counts'] and native['accepted'] is True
+              and native['process_unchanged'] is True and native['main_exit_code'] == 0, 'original native binding')
+    report = data['generic_audit']
+    w.require(report['accepted'] is True and report['evidence_complete'] is True, 'original generic invalid')
+    command = data['command_receipt']
+    w.require(command == {'argv': [manifest['argv'][0], '-m', 'scripts.qd_ed_n32_worker', '--context', entry['context']['path'], '--context-sha256', entry['context']['sha256']],
+                         'main_argv': manifest['argv'], 'context': entry['context']}, 'original command binding')
+    w.require(terminal['identity'] == old_supervisor.c_identity(row) and terminal['attempt_id'] == terminal['episode_key'] == key
+              and terminal['source_commit'] == parent['source']['commit'] and terminal['plan_sha256'] == plan['parent_plan']['sha256']
+              and terminal['release'] == plan['parent_release'] and terminal['context'] == entry['context']
+              and terminal['runtime_manifest_sha256'] == parent['runtime']['sha256']
+              and terminal['runtime_inventory_sha256'] == parent['runtime_inventory_sha256']
+              and terminal['budget_bucket'] == row['budget_bucket'] and terminal['init_row_sha256'] == row['init_row_sha256']
+              and terminal['physical_gpu'] == 7 and terminal['output_dir'] == str(output), 'original terminal identity')
+    elapsed = c.finite(terminal['gpu_process_wall_seconds'], 'original charge')
+    w.require(elapsed / 3600 == entry['gpu_hours_retained'] and entry['budget_bucket_retained'] == row['budget_bucket'], 'retained charge differs')
+    if valid:
+        w.require(c.same_ref(terminal['n32_worker_receipt'], entry['native_receipt']), 'original terminal native receipt')
+        w.require(terminal['event'] == 'valid' and terminal['outcome_valid'] is True
+                  and terminal['required_cost_telemetry_complete'] is True and type(terminal['success']) is bool
+                  and terminal['success'] == entry['success'], 'original terminal invalid')
+    else:
+        w.require(terminal['event'] == 'aborted' and terminal['outcome_valid'] is False and terminal['success'] is None, 'old invalid must remain invalid')
+    return terminal
+
+
+def verified_parent(plan, events):
+    from scripts.qd_ed_n32r3_release import verify_continuity
+    verify_continuity(plan)
+    w.verify_source(plan['worktree'], plan['source'])
+    mapping, parent = validate_mapping(plan)
+    outcomes = []
+    historical_ids = {x['attempt_id'] for x in mapping['accepted_cells']} | {c.OLD_INVALID}
+    w.require(all(e['attempt_id'] in historical_ids for e in events
+                  if e.get('identity', {}).get('iteration') == old.COHORT), 'parent cohort changed after reviewed prefix')
+    for entry in mapping['accepted_cells'] + [mapping['old_invalid_cell']]:
+        valid = entry is not mapping['old_invalid_cell']
+        terminal = verify_cell(entry, plan, parent, valid=valid)
+        group = [e for e in events if e['attempt_id'] == entry['attempt_id']]
+        w.require([e['event'] for e in group] == ['reserved', 'dispatched', terminal['event']]
+                  and group[-1] == terminal, 'original journal/receipt lifecycle differs')
+        immutable = ('attempt_id','episode_key','identity','plan_sha256','release','source_commit','runtime_manifest_sha256',
+                     'runtime_inventory_sha256','init_row_sha256','output_dir','physical_gpu','context','ledger_prefix','budget_bucket')
+        w.require(all(all(k in e and e[k] == terminal[k] for k in immutable) and e.get('retry_of') is None
+                      and e.get('recovery_of') is None for e in group), 'parent lifecycle drift')
+        if valid:
+            outcomes.append({'task_id': entry['original_row']['task_id'], 'profile': entry['original_row']['profile'],
+                             'success': terminal['success'], 'attempt_id': terminal['attempt_id']})
+    return outcomes
+
+
+def verify_preparation_anchor(plan):
+    """The existing independent bounded review is evidence, never new authority."""
+    w.require(plan['preparation_review']['sha256'] == '8666822f801c4e04aece1e7e9bb48c245ec206e69a8d73f8821a9022fbc91428', 'independent preparation review anchor')
+    review = c.read_ref(plan['preparation_review'])
+    w.require(review['status'] == 'PASS_FOR_BOUNDED_CPU_IMPLEMENTATION_ONLY' and review['source'] == c.BASE_SOURCE
+              and review['accepted_historical_cells'] == 14 and review['proposed_cells'] == 16, 'preparation review scope')
+    index = c.read_ref(review['artifact_index'])
+    for key in ('carry_forward_map', 'command_candidates'):
+        matches = [x for x in index['artifacts'] if c.same_ref(x, plan[key])]
+        w.require(len(matches) == 1, 'map/commands not independently reviewed')
+        c.read_ref(matches[0])
diff --git a/scripts/qd_ed_n32r3_prepare.py b/scripts/qd_ed_n32r3_prepare.py
new file mode 100644
index 0000000000000000000000000000000000000000..b5deeb105b62688ca2d7e7a6210c52c9482007ca
--- /dev/null
+++ b/scripts/qd_ed_n32r3_prepare.py
@@ -0,0 +1,45 @@
+"""CPU manifest composition only. Never creates/adopts a release or runs a worker."""
+import argparse
+import json
+from pathlib import Path
+from scripts import qd_ed_n23_worker as w, qd_ed_n32r3_bridge as b
+from scripts import qd_ed_n32r3_contract as c, qd_ed_n32r3_release as release
+from scripts.qd_ed_n32r3_history import validate_mapping
+
+
+def compose(plan_ref, destination):
+    plan = w.read_ref(plan_ref)
+    # A separate operational source approval precedes composition. The input is
+    # still disabled; manifests alone cannot grant execution authority.
+    w.require(plan['schema'] == 'n32r3-composition-input-v1' and plan['release_enabled'] is False
+              and plan['episodes'] == c.expected_rows(plan['worktree']), 'disabled composition input required')
+    validate_mapping(plan)
+    release.verify_continuity(plan)
+    w.verify_source(plan['worktree'], plan['source'])
+    runtime = w.read_ref(plan['runtime'])
+    destination = Path(destination).resolve()
+    b.runner.owned(destination, plan['artifact_root'])
+    w.require(not destination.exists(), 'manifest destination exists')
+    # Compose everything before writing, and never reuse old config digests.
+    manifests = [b.manifest(plan, runtime, row) for row in plan['episodes']]
+    refs = {}
+    for manifest in manifests:
+        key = manifest['row']['episode_key']
+        path = destination / (key + '.json')
+        w.atomic_json(path, manifest)
+        refs[key] = c.ref(path)
+    w.atomic_json(destination / 'manifest-index.json', {'schema': 'n32r3-manifest-index-v1',
+                  'plan': plan_ref, 'release_enabled': False, 'expected_manifests': refs})
+    return refs
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    for name in ('plan', 'plan-sha256', 'destination'):
+        parser.add_argument('--'+name, required=True)
+    args = parser.parse_args()
+    print(json.dumps(compose({'path': str(Path(args.plan).resolve()), 'sha256': args.plan_sha256}, args.destination)))
+
+
+if __name__ == '__main__':
+    main()
