+        and gate.get('accepted') is True and gate.get('guided_decisions')==len(metrics),'N27 profile gate missing')
+    rows=[r for m in metrics for r in call_rows(m)]
+    require(gate.get('all_call_summaries_verified')==len(rows)
+        and type(gate.get('witness_calls_verified')) is int and gate['witness_calls_verified']==(11 if metrics else 0)
+        and gate.get('zero_gradient_calls')==sum(v['zero_gradient'] for v in rows)
+        and gate.get('clipped_components')==sum(v['clipped_components'] for v in rows)
+        and gate.get('limited_rows')==sum(v['limited_rows'] for v in rows)
+        and gate.get('realized_nonzero_delta_components')==sum(v['realized_nonzero_delta_components'] for v in rows),'N27 audit counts differ')
+    counts.update({k:gate[k] for k in ('all_call_summaries_verified','witness_calls_verified','zero_gradient_calls','clipped_components','limited_rows','realized_nonzero_delta_components')})
+    return counts,aux
+
+
+def from_output(profile,output,report,guided_count=None):
+    # Preserve strict episode/native/metric zero-guided omission compatibility.
+    require(profile in ARMS,'unknown arm')
