+{
+  "base": "6292fc8cffad2eec0f789e023d835ad3c1df146a",
+  "source_sha256": "ba1728c637a30d1aeb42e257b8af5fea0248089c26aaf84c65f813fbd719928a",
+  "policy": {
+    "reset": "def reset(self) -> None:\n        self._n25_rbf_witness = BoundedWitness()\n        self._n26_rbf_witness = CleanOutputWitness()\n        self._n27_rbf_witness = FeasibleRayWitness()\n        self._n28_rbf_witness = ParentWitness()\n        self._n29_rbf_witness = TrustWitness()\n        self.reset_episode_compute_counters()\n        if hasattr(self, \"_executed_feedback\"):\n            self._executed_feedback.clear(\"episode_reset\", reset=True)\n        if hasattr(self, \"_executed_progress\"):\n            self._executed_progress.clear(\"episode_reset\", reset=True)\n        self.reset_eds_chunk_memory(\"episode_reset\")\n        self._cached_action_chunk = None\n        self._cached_action_steps_remaining = 0\n        self._stage_init_reward = None\n        self._last_normalized_reward = 0.0\n        self._last_scale = 0.0\n        self._last_raw_reward = 0.0\n        self._current_alpha_t = 0.5\n        self._action_summary_logged = False\n        self._last_visualization_action_candidates = None\n        self._last_eds_metrics = None\n        self._last_eds_artifacts = None\n        self._last_eds_initial_sampler_info = None\n        self._last_eds_mechanism_trace = None\n        if self._obs_processor is not None:\n            self._obs_processor.reset()",
+    "reset_stage": "def reset_stage(self) -> None:\n        if hasattr(self, \"_executed_feedback\"):\n            self._executed_feedback.clear(\"stage_change\")\n        if hasattr(self, \"_executed_progress\"):\n            self._executed_progress.clear(\"stage_change\")\n        self.reset_eds_chunk_memory(\"stage_change\")\n        self._stage_init_reward = None",
+    "reset_eds_chunk_memory": "def reset_eds_chunk_memory(self, reason: str, *, warn: bool = False) -> None:\n        self._eds_chunk_memory = None\n        self._eds_chunk_memory_reset_reason = str(reason)\n        if warn:\n            log.warning(f\"EDS chunk population memory reset: reason={reason}\")",
+    "select_action": "def select_action(\n        self,\n        batch: dict,\n        generate_new_chunk: bool = False,\n        use_guidance: bool = False,\n        keypoints: Optional[np.ndarray] = None,\n        guidance_fns: Optional[List[Callable]] = None,\n        guidance_type: str = \"vls\",\n        vls_config: Optional[dict] = None,\n        eds_config: Optional[dict] = None,\n        guide_scale: Optional[float] = None,\n        sample_batch_size: Optional[int] = None,\n        use_diversity: Optional[bool] = None,\n        diversity_scale: Optional[float] = None,\n        MCMC_steps: Optional[int] = None,\n        use_fkd: Optional[bool] = None,\n        fkd_config: Optional[dict] = None,\n        sigmoid_k: Optional[float] = None,\n        sigmoid_x0: Optional[float] = None,\n        start_ratio: Optional[float] = None,\n        verbose: bool = False,\n        global_step: int = 0,\n        current_stage: int = 1,\n        execution_feedback_context: dict | None = None,\n        executed_progress_context: dict | None = None,\n    ) -> Tensor:\n        if self._obs_processor is None:\n            raise RuntimeError(\"RDTSteer.post_init must be called before select_action\")\n\n        self._obs_processor.observe(batch)\n        should_sample = (\n            generate_new_chunk\n            or self._cached_action_chunk is None\n            or self._cached_action_steps_remaining <= 0\n        )\n\n        if should_sample:\n            self._execution_feedback_context = execution_feedback_context\n            self._executed_progress_context = executed_progress_context\n            progress_mode = (eds_config or {}).get(\"executed_progress_continuation_mode\", \"off\") == PROGRESS_MODE\n            if hasattr(self, \"_executed_progress\") and (not progress_mode or not use_guidance):\n                self._executed_progress.clear(\"guidance_gap_or_mode_off\")\n            feedback_mode = (eds_config or {}).get(\"qd_quality_mode\") == FEEDBACK_MODE\n            if hasattr(self, \"_executed_feedback\") and (not feedback_mode or not use_guidance):\n                self._executed_feedback.clear(\"guidance_off_or_mode_changed\")\n            self._increment_compute(\"guided_chunks\" if use_guidance else \"unguided_chunks\")\n            self._last_visualization_action_candidates = None\n            self._last_eds_metrics = None\n            self._last_eds_artifacts = None\n            self._last_eds_mechanism_trace = None\n            converted = self._obs_processor.current()\n\n            if use_guidance:\n                text_embed = self._get_lang_embed(converted.task)\n                merged_vls_config = _merge_legacy_vls_kwargs(\n                    vls_config,\n                    guide_scale=guide_scale,\n                    sample_batch_size=sample_batch_size,\n                    use_diversity=use_diversity,\n                    diversity_scale=diversity_scale,\n                    MCMC_steps=MCMC_steps,\n                    use_fkd=use_fkd,\n                    fkd_config=fkd_config,\n                    sigmoid_k=sigmoid_k,\n                    sigmoid_x0=sigmoid_x0,\n                    start_ratio=start_ratio,\n                )\n                raw = self._predict_guided(\n                    converted.state_128,\n                    converted.state_mask_128,\n                    converted.images,\n                    text_embed,\n                    keypoints=keypoints,\n                    guidance_fns=guidance_fns,\n                    guidance_type=guidance_type,\n                    vls_config=merged_vls_config,\n                    eds_config=eds_config,\n                    verbose=verbose,\n                    global_step=global_step,\n                    current_stage=current_stage,\n                )\n            else:\n                text_embed = self._get_lang_embed(converted.task)\n                raw = self._predict_unguided(\n                    converted.state_128,\n                    converted.state_mask_128,\n                    converted.images,\n                    text_embed,\n                    B=1,\n                )\n\n            self._cached_action_chunk = self._postprocess_actions(raw)\n            if progress_mode and hasattr(self, \"_executed_progress\"):\n                self._executed_progress.bind_decode(raw, self._cached_action_chunk)\n                self._record_progress_event(\"n30_decode_binding\", actions=self._cached_action_chunk)\n            if feedback_mode and hasattr(self, \"_executed_feedback\"):\n                feedback_started = time.perf_counter()\n                self._executed_feedback.bind_decode(raw, self._cached_action_chunk, ACTIVE_ACTION_INDICES_SORTED)\n                self.record_execution_feedback_overhead(\"selected_decode_binding\", time.perf_counter() - feedback_started)\n            evidence = getattr(self, \"_decision_evidence\", None)\n            if evidence is not None:\n                evidence.record(\"policy_action_decode\", selected_latent=raw,\n                                action_chunk=self._cached_action_chunk)\n            self._cached_action_steps_remaining = self._cached_action_chunk.shape[1]\n\n        self._cached_action_steps_remaining = max(0, self._cached_action_steps_remaining - 1)\n        return self._cached_action_chunk",
+    "_observe_eds_score_call": "def _observe_eds_score_call(self, *, role, iter_idx, site):\n        evidence = getattr(self, \"_decision_evidence\", None)\n        if evidence is not None:\n            evidence.set_scoring_scope(role=role, iter_idx=iter_idx, site=site)",
+    "_eds_score_population_as_cost": "def _eds_score_population_as_cost(\n        self,\n        samples: Tensor,\n        *,\n        keypoints: Optional[Tensor],\n        guidance_fns: Optional[List[Callable]],\n        reward_mode: str = \"normal\",\n        shuffle_seed: int = 0,\n        qd_quality_contract: ExecutedPrefixContract | FeedbackContract | None = None,\n    ) -> tuple[Tensor, dict]:\n        reward_mode = str(reward_mode or \"normal\")\n        valid_modes = {\"normal\", \"zero\", \"shuffled_keypoints\", \"inverted\"}\n        if reward_mode not in valid_modes:\n            raise ValueError(f\"Unsupported EDS reward_mode={reward_mode!r}\")\n\n        evidence = getattr(self, \"_decision_evidence\", None)\n        if evidence is not None:\n            evidence.begin_score_call()\n        scoring_keypoints = keypoints\n        if (\n            reward_mode == \"shuffled_keypoints\"\n            and keypoints is not None\n            and keypoints.shape[0] > 1\n        ):\n            generator = torch.Generator(device=keypoints.device)\n            generator.manual_seed(int(shuffle_seed))\n            perm = torch.randperm(\n                keypoints.shape[0],\n                generator=generator,\n                device=keypoints.device,\n            )\n            scoring_keypoints = keypoints.index_select(0, perm)\n\n        projection_out = ({\"capture_origin\": True} if isinstance(qd_quality_contract, (FeedbackContract, ActuatorClippedContract))\n                          else {} if qd_quality_contract is not None else None)\n        if qd_quality_contract is not None:\n            if reward_mode != \"normal\":\n                raise RuntimeError(\"N2 canonical quality requires original normal reward mode\")\n            qd_quality_contract.validate(guidance_fns)\n        rewards = self._score_particles(\n            samples,\n            scoring_keypoints,\n            guidance_fns,\n            slice_kind=\"eds\",\n            **({\"projection_out\": projection_out} if projection_out is not None else {}),\n        )\n        if reward_mode == \"zero\":\n            rewards = torch.zeros_like(rewards)\n        elif reward_mode == \"inverted\":\n            rewards = -rewards\n        quality_info = {}\n        if qd_quality_contract is not None:\n            qd_quality_contract.validate(guidance_fns)\n            if not torch.isfinite(rewards).all():\n                raise FloatingPointError(\"N2 original provider reward is nonfinite\")\n            quality_info[\"raw_rewards\"] = rewards.detach().clone()\n            quality_info[\"qd_scored_actions\"] = samples.detach().clone()\n            if isinstance(qd_quality_contract, ActuatorClippedContract):\n                rewards, clipped_mask = qd_quality_contract.score(\n                    samples[:, :8, RDT_GUIDED_TRANSLATION_INDICES], projection_out[\"source_origins\"],\n                    projection_out[\"projected_xyz\"], scoring_keypoints, rewards)\n                quality_info[\"clipped_prefix_mask\"] = clipped_mask\n            elif isinstance(qd_quality_contract, LiftAfterCloseContract):\n                decoded = self._decode_visualization_action_candidates(samples)\n                bonus_function = (close_hold_then_lift_bonus\n                                  if qd_quality_contract.mode == HOLD_LIFT_MODE\n                                  else close_then_lift_bonus)\n                bonus = bonus_function(\n                    projection_out[\"projected_xyz\"], scoring_keypoints, decoded,\n                    target_index=qd_quality_contract.target_index,\n                ).to(device=rewards.device, dtype=rewards.dtype)\n                quality_info[\"lift_bonus\"] = bonus.detach().clone()\n                if bool((bonus != 0).any().item()):\n                    rewards = rewards + bonus\n            elif isinstance(qd_quality_contract, FeedbackContract):\n                qd_quality_contract.record(samples, projection_out[\"projected_xyz\"],\n                                           projection_out[\"source_origins\"], rewards)\n                if qd_quality_contract.active:\n                    quality_started = time.perf_counter()\n                    rewards = executed_feedback_quality(projection_out[\"projected_xyz\"], scoring_keypoints,\n                        target_index=qd_quality_contract.target_index, residual_previous=qd_quality_contract.residual)\n                    qd_quality_contract.overhead_seconds += time.perf_counter() - quality_started\n                # No eligible history: retain the exact already-computed raw tensor.\n            else:\n                rewards = executed_prefix_quality(projection_out[\"projected_xyz\"], scoring_keypoints,\n                                                  target_index=qd_quality_contract.target_index)\n            if rewards.shape != quality_info[\"raw_rewards\"].shape or rewards.dtype != samples.dtype:\n                raise RuntimeError(\"N2 canonical quality/raw association mismatch\")\n        costs = -rewards\n        evidence = getattr(self, \"_decision_evidence\", None)\n        if evidence is not None:\n            evidence.record(\"effective_quality\", scoring_batch_id=evidence.scoring_batch_id,\n                            reward_mode=reward_mode, quality=rewards, costs=costs,\n                            **({\"quality_mode\": getattr(qd_quality_contract, \"mode\", \"executed_prefix_v1\"),\n                                \"raw_provider_quality\": quality_info[\"raw_rewards\"],\n                                \"target_index\": qd_quality_contract.target_index,\n                                \"provider_identity\": qd_quality_contract.identity,\n                                **({\"actuator_metadata\": qd_quality_contract.metadata,\n                                    \"clipped_prefix_mask\": quality_info[\"clipped_prefix_mask\"]}\n                                   if isinstance(qd_quality_contract, ActuatorClippedContract) else {}),\n                                **({\"lift_bonus\": quality_info[\"lift_bonus\"]}\n                                   if isinstance(qd_quality_contract, LiftAfterCloseContract) else {})}\n                               if qd_quality_contract is not None else {}))\n        return costs.detach(), {\"rewards\": rewards.detach(), **quality_info}",
+    "_eds_rollout_baseline_reference": "def _eds_rollout_baseline_reference(\n        self,\n        *,\n        cond: dict,\n        action_mask: Tensor,\n        noisy_action: Tensor,\n        keypoints: Optional[Tensor],\n        guidance_fns: Optional[List[Callable]],\n        n_trunc_steps: int,\n        reward_mode: str = \"normal\",\n        shuffle_seed: int = 0,\n        cfg: Optional[_EDSConfig] = None,\n        qd_quality_contract: ExecutedPrefixContract | FeedbackContract | None = None,\n    ) -> tuple[Tensor, Tensor, dict]:\n        x_t = self._eds_denoise_noisy_population(\n            cond=cond,\n            action_mask=action_mask,\n            noisy_action=noisy_action,\n            n_trunc_steps=n_trunc_steps,\n        )\n        costs, info = self._eds_score_population_as_cost(\n            x_t,\n            keypoints=keypoints,\n            guidance_fns=guidance_fns,\n            reward_mode=reward_mode,\n            shuffle_seed=shuffle_seed,\n            **({\"qd_quality_contract\": qd_quality_contract} if qd_quality_contract is not None else {}),\n        )\n        info = {**self._eds_empty_rollout_diversity_info(cfg), **info}\n        return x_t, costs, info",
+    "_eds_rollout_rbf_diverse_reference": "def _eds_rollout_rbf_diverse_reference(\n        self,\n        *,\n        cond: dict,\n        action_mask: Tensor,\n        noisy_action: Tensor,\n        keypoints: Optional[Tensor],\n        guidance_fns: Optional[List[Callable]],\n        n_trunc_steps: int,\n        reward_mode: str,\n        shuffle_seed: int,\n        cfg: _EDSConfig,\n        iter_idx: int,\n        diversity_scale_override: float | None = None,\n        qd_quality_contract: ExecutedPrefixContract | FeedbackContract | None = None,\n    ) -> tuple[Tensor, Tensor, dict]:\n        scheduler = self._noise_scheduler\n        require_sample_scheduler(cfg, scheduler)\n        self._increment_compute(\"denoising_invocations\")\n        scheduler.set_timesteps(self._num_inference_steps)\n        n_trunc_steps = int(max(1, min(n_trunc_steps, len(scheduler.timesteps))))\n        rollout_timesteps = scheduler.timesteps[-n_trunc_steps:]\n        x_t = noisy_action\n        mask = self._expand_action_mask_for_population(action_mask, x_t)\n        info = self._eds_empty_rollout_diversity_info(cfg)\n        info[\"rollout_diversity_mode\"] = cfg.truncated_rollout_mode\n        actual_scale = float(cfg.rollout_diversity_scale)\n        if (\n            cfg.rollout_diversity_control_mode == \"adaptive_band\"\n            and diversity_scale_override is not None\n        ):\n            if (\n                isinstance(diversity_scale_override, bool)\n                or not isinstance(diversity_scale_override, Real)\n                or not math.isfinite(float(diversity_scale_override))\n                or float(diversity_scale_override) < 0.0\n            ):\n                raise ValueError(\n                    \"EDS adaptive rollout diversity scale override must be finite and nonnegative\"\n                )\n            actual_scale = float(diversity_scale_override)\n        info[\"rollout_diversity_scale\"] = actual_scale\n        before_population = x_t.detach()\n        after_rbf_population: Optional[Tensor] = None\n        grad_norms: list[float] = []\n        steps_applied = 0\n        rbf_step_flags: list[bool] = []\n\n        if actual_scale > 0.0 and x_t.shape[0] <= 1:\n            if cfg.rollout_diversity_descriptor_mode == CLIPPED_RBF_MODE:\n                raise ValueError(\"N25 requires population>=2; no fallback\")\n            return self._eds_rollout_fallback_to_baseline(\n                reason=\"population_size<=1\",\n                iter_idx=iter_idx,\n                step_idx=None,\n                timestep=None,\n                cfg=cfg,\n                cond=cond,\n                action_mask=action_mask,\n                noisy_action=noisy_action,\n                keypoints=keypoints,\n                guidance_fns=guidance_fns,\n                n_trunc_steps=n_trunc_steps,\n                reward_mode=reward_mode,\n                shuffle_seed=shuffle_seed,\n                **({\"qd_quality_contract\": qd_quality_contract} if qd_quality_contract is not None else {}),\n                attempted_diversity_scale=actual_scale,\n            )\n\n        for local_step, t in enumerate(rollout_timesteps):\n            with torch.no_grad():\n                model_output = self._counted_dit(x_t, t, cond)\n\n            applied_this_step = False\n            if actual_scale > 0.0 and self._eds_rollout_diversity_step_mask(\n                cfg,\n                rollout_timesteps,\n                local_step,\n            ):\n                capture = (self._eds_rbf_witness(cfg).prepare(\"rollout\", int(iter_idx))\n                           if cfg.rollout_diversity_descriptor_mode == CLIPPED_RBF_MODE else None)\n                rbf_input = geometry_input(x_t, model_output, cfg, scheduler)\n                div_grad, descriptor_evidence = self._compute_eds_diversity_gradient(\n                    rbf_input,\n                    descriptor_mode=cfg.rollout_diversity_descriptor_mode,\n                    descriptor_cfg=cfg.__dict__,\n                    **({\"capture_out\": capture} if capture is not None else {}),\n                )\n                bind_input_evidence(descriptor_evidence, cfg, scheduler)\n                info.setdefault(\"direction_rbf_evidence_by_step\", []).append(\n                    descriptor_evidence\n                )\n                if div_grad is None:\n                    return self._eds_rollout_fallback_to_baseline(\n                        reason=f\"diversity_gradient_none_at_step={local_step}_t={int(t.item())}\",\n                        iter_idx=iter_idx,\n                        step_idx=local_step,\n                        timestep=int(t.item()),\n                        cfg=cfg,\n                        cond=cond,\n                        action_mask=action_mask,\n                        noisy_action=noisy_action,\n                        keypoints=keypoints,\n                        guidance_fns=guidance_fns,\n                        n_trunc_steps=n_trunc_steps,\n                        reward_mode=reward_mode,\n                        shuffle_seed=shuffle_seed,\n                        **({\"qd_quality_contract\": qd_quality_contract} if qd_quality_contract is not None else {}),\n                        attempted_diversity_scale=actual_scale,\n                    )\n                if not torch.isfinite(div_grad).all():\n                    return self._eds_rollout_fallback_to_baseline(\n                        reason=f\"non-finite_diversity_gradient_at_step={local_step}_t={int(t.item())}\",\n                        iter_idx=iter_idx,\n                        step_idx=local_step,\n                        timestep=int(t.item()),\n                        cfg=cfg,\n                        cond=cond,\n                        action_mask=action_mask,\n                        noisy_action=noisy_action,\n                        keypoints=keypoints,\n                        guidance_fns=guidance_fns,\n                        n_trunc_steps=n_trunc_steps,\n                        reward_mode=reward_mode,\n                        shuffle_seed=shuffle_seed,\n                        **({\"qd_quality_contract\": qd_quality_contract} if qd_quality_contract is not None else {}),\n                        attempted_diversity_scale=actual_scale,\n                    )\n                masked_div = self._mask_guidance_gradient(div_grad).to(\n                    device=model_output.device,\n                    dtype=model_output.dtype,\n                )\n                grad_norms.append(float(masked_div.detach().norm().cpu().item()))\n                if cfg.rollout_diversity_descriptor_mode == CLIPPED_RBF_MODE:\n                    update = (RDT_DIVERSITY_SIGN * actual_scale\n                              * masked_div[:, :, RDT_GUIDED_TRANSLATION_INDICES])\n                    applied_evidence(descriptor_evidence, masked=masked_div, update=update,\n                                     phase=\"rollout\", iteration=int(iter_idx),\n                                     step=local_step, timestep=int(t.item()))\n                    if capture is not None:\n                        capture[\"update_operand\"] = update[:, :8, :].detach().clone()\n                        capture[\"model_output_before\"] = model_output[:, :8, RDT_GUIDED_TRANSLATION_INDICES].detach().clone()\n                    if cfg.diversity_update_mode == FEASIBLE_RBF_UPDATE:\n                        before_feasible = model_output[:, :8, RDT_GUIDED_TRANSLATION_INDICES].detach().clone()\n                        feasible, feasible_started = feasible_rbf_step(before_feasible, update[:, :8, :], cfg, scheduler)\n                        model_output[:, :8, RDT_GUIDED_TRANSLATION_INDICES] = feasible.prefix\n                        observe_feasible_rbf(descriptor_evidence, before_feasible,\n                                             model_output[:, :8, RDT_GUIDED_TRANSLATION_INDICES],\n                                             update[:, :8, :], feasible.alpha, feasible_started)\n                    else:\n                        model_output[:, :, RDT_GUIDED_TRANSLATION_INDICES] += update\n                    if capture is not None:\n                        capture[\"model_output_after\"] = model_output[:, :8, RDT_GUIDED_TRANSLATION_INDICES].detach().clone()\n                        self._eds_rbf_witness(cfg).emit(capture, descriptor_evidence)\n                else:\n                    model_output[:, :, RDT_GUIDED_TRANSLATION_INDICES] += (\n                        RDT_DIVERSITY_SIGN\n                        * actual_scale\n                        * masked_div[:, :, RDT_GUIDED_TRANSLATION_INDICES]\n                    )\n                steps_applied += 1\n                applied_this_step = True\n\n            rbf_step_flags.append(bool(applied_this_step))\n\n            if not torch.isfinite(model_output).all():\n                if cfg.rollout_diversity_descriptor_mode == CLIPPED_RBF_MODE:\n                    raise ValueError(\"N25 nonfinite model_output; no fallback\")\n                return self._eds_rollout_fallback_to_baseline(\n                    reason=f\"non-finite_model_output_at_step={local_step}_t={int(t.item())}\",\n                    iter_idx=iter_idx,\n                    step_idx=local_step,\n                    timestep=int(t.item()),\n                    cfg=cfg,\n                    cond=cond,\n                    action_mask=action_mask,\n                    noisy_action=noisy_action,\n                    keypoints=keypoints,\n                    guidance_fns=guidance_fns,\n                    n_trunc_steps=n_trunc_steps,\n                    reward_mode=reward_mode,\n                    shuffle_seed=shuffle_seed,\n                    **({\"qd_quality_contract\": qd_quality_contract} if qd_quality_contract is not None else {}),\n                    attempted_diversity_scale=actual_scale,\n                )\n            x_t = self._counted_scheduler_step(scheduler, model_output, t, x_t).prev_sample.to(dtype=noisy_action.dtype)\n            if applied_this_step:\n                after_rbf_population = x_t.detach()\n            if not torch.isfinite(x_t).all():\n                if cfg.rollout_diversity_descriptor_mode == CLIPPED_RBF_MODE:\n                    raise ValueError(\"N25 nonfinite x_t; no fallback\")\n                return self._eds_rollout_fallback_to_baseline(\n                    reason=f\"non-finite_population_at_step={local_step}_t={int(t.item())}\",\n                    iter_idx=iter_idx,\n                    step_idx=local_step,\n                    timestep=int(t.item()),\n                    cfg=cfg,\n                    cond=cond,\n                    action_mask=action_mask,\n                    noisy_action=noisy_action,\n                    keypoints=keypoints,\n                    guidance_fns=guidance_fns,\n                    n_trunc_steps=n_trunc_steps,\n                    reward_mode=reward_mode,\n                    shuffle_seed=shuffle_seed,\n                    **({\"qd_quality_contract\": qd_quality_contract} if qd_quality_contract is not None else {}),\n                    attempted_diversity_scale=actual_scale,\n                )\n\n        x_t = x_t * mask\n        if after_rbf_population is not None:\n            after_rbf_population = after_rbf_population * mask\n        final_population = x_t.detach()\n        costs, score_info = self._eds_score_population_as_cost(\n            x_t,\n            keypoints=keypoints,\n            guidance_fns=guidance_fns,\n            reward_mode=reward_mode,\n            shuffle_seed=shuffle_seed,\n            **({\"qd_quality_contract\": qd_quality_contract} if qd_quality_contract is not None else {}),\n        )\n        info.update(score_info)\n        info[\"rollout_diversity_enabled\"] = steps_applied > 0\n        info[\"rollout_diversity_iters_applied\"] = 1 if steps_applied > 0 else 0\n        info[\"rollout_diversity_steps_applied\"] = int(steps_applied)\n        info[\"roll