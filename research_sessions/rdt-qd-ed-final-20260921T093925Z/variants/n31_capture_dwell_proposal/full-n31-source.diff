+    "_eds_guided_denoise_loop": "def _eds_guided_denoise_loop(\n        self,\n        *,\n        x_t: Tensor,\n        cond: dict,\n        keypoints: Optional[Tensor],\n        guidance_fns: Optional[List[Callable]],\n        eds_config: _EDSConfig,\n        verbose: bool,\n        global_step: int,\n        current_stage: int,\n    ) -> Tensor:\n        cfg = eds_config\n        progress_mode = cfg.executed_progress_continuation_mode == PROGRESS_MODE\n        progress_semantic = None\n        if progress_mode:\n            if not hasattr(self, \"_executed_progress\"):\n                self._executed_progress = ProgressContinuation()\n            progress_recognition_error = False\n            try:\n                progress_semantic, _ = recognize_executed_prefix_provider(guidance_fns, keypoints)\n            except (ValueError, TypeError, FloatingPointError):\n                progress_semantic = None\n                progress_recognition_error = True\n            self._executed_progress.begin(progress_semantic,\n                getattr(self, \"_executed_progress_context\", None), stage=current_stage, step=global_step)\n            if progress_recognition_error:\n                self._executed_progress.clear(\"invalid_provider_or_keypoints\", invalid=True)\n        if cfg.initial_diversity_descriptor_mode == CLIPPED_RBF_MODE:\n            self._eds_rbf_witness(cfg).begin(getattr(self, \"_decision_evidence\", None))\n        contact_sweep_mode = cfg.qd_final_selection_mode == CONTACT_SWEEP_MODE\n        grasp_timing_mode = cfg.qd_final_selection_mode in {GRASP_TIMING_MODE, CONTACT_SWEEP_MODE}\n        terminal_mode = cfg.qd_final_selection_mode in {TERMINAL_POPULATION_MODE, GRASP_TIMING_MODE, CONTACT_SWEEP_MODE}\n        if terminal_mode and self._action_chunk_horizon != 8:\n            raise ValueError(\"Terminal population selection requires action_chunk_horizon=8\")\n        terminal_population = None\n        terminal_projected_xyz = None\n        grasp_contract = None\n        grasp_reason = None\n        grasp_selection = None\n        contact_selection = None\n        if grasp_timing_mode:\n            grasp_contract, grasp_reason = recognize_executed_prefix_provider(guidance_fns, keypoints)\n        terminal_canonical_sequence = None\n        terminal_scoring_batch_id = None\n        feedback_setup_started = time.perf_counter() if cfg.qd_quality_mode == FEEDBACK_MODE else None\n        quality_contract = None\n        quality_reason = \"provider_mode\"\n        if cfg.qd_quality_mode in {\"executed_prefix_v1\", FEEDBACK_MODE, ACTUATOR_CLIPPED_MODE, *LIFT_MODES}:\n            if self._action_chunk_horizon != 8:\n                raise ValueError(\"Executed-prefix quality requires action_chunk_horizon=8\")\n            quality_contract, quality_reason = recognize_executed_prefix_provider(guidance_fns, keypoints)\n            if cfg.qd_quality_mode in LIFT_MODES:\n                if quality_contract is None:\n                    raise RuntimeError(f\"N18 provider semantic identity unavailable: {quality_reason}\")\n                quality_contract = LiftAfterCloseContract(quality_contract, mode=cfg.qd_quality_mode)\n            if cfg.qd_quality_mode == ACTUATOR_CLIPPED_MODE:\n                if quality_contract is None:\n                    raise RuntimeError(f\"N23 provider semantic identity unavailable: {quality_reason}\")\n                quality_contract = ActuatorClippedContract(quality_contract, self._adapter)\n                quality_contract.validate(guidance_fns)\n                evidence = getattr(self, \"_decision_evidence\", None)\n                if evidence is not None:\n                    evidence.record(\"actuator_metadata_snapshot\", metadata=quality_contract.metadata)\n            if cfg.qd_quality_mode == FEEDBACK_MODE:\n                if not hasattr(self, \"_executed_feedback\"):\n                    self._executed_feedback = ExecutedFeedbackHistory()\n                if quality_contract is None:\n                    self._executed_feedback.clear(quality_reason)\n                elif not getattr(self._adapter, \"supports_execution_feedback_origin\", False):\n                    self._executed_feedback.clear(\"projection_origin_unavailable\")\n                    quality_contract, quality_reason = None, \"projection_origin_unavailable\"\n                else:\n                    quality_contract = self._executed_feedback.begin(quality_contract, stage=current_stage,\n                        global_step=global_step, tracker=getattr(self, \"_execution_feedback_context\", None))\n        if feedback_setup_started is not None:\n            self.record_execution_feedback_overhead(\"semantic_context_begin\", time.perf_counter() - feedback_setup_started)\n        quality_kwargs = ({\"qd_quality_contract\": quality_contract} if quality_contract is not None else {})\n        execution_intent = cfg.qd_descriptor == EXECUTION_INTENT_DESCRIPTOR\n        height_aware = cfg.qd_descriptor == HEIGHT_AWARE_DESCRIPTOR\n        direction_height = cfg.qd_descriptor == DIRECTION_HEIGHT_DESCRIPTOR\n        non_xy_descriptor = execution_intent or height_aware or direction_height\n        if execution_intent and self._action_chunk_horizon != 8:\n            raise ValueError(\"Execution-intent QD requires action_chunk_horizon=8\")\n        if height_aware and self._action_chunk_horizon != 8:\n            raise ValueError(\"Height-aware QD requires action_chunk_horizon=8\")\n        if direction_height and self._action_chunk_horizon != 8:\n            raise ValueError(\"Direction-height QD requires action_chunk_horizon=8\")\n        def describe_qd(candidates, *, projection_out=None):\n            if projection_out is None:\n                if non_xy_descriptor:\n                    return self._eds_qd_descriptor(candidates, keypoints, cfg.qd_descriptor)\n                return self._eds_qd_descriptor(candidates, keypoints)\n            if non_xy_descriptor:\n                return sel