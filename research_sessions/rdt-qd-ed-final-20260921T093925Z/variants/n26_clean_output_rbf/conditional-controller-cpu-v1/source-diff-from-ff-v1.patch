+        elif fault=='origin':wi[0]['values']['tensors']['source_origins'][0,0]+=1
+        elif fault in ('operand','output'):wi[0]['values']['tensors']['update_operand' if fault=='operand' else 'model_output_after'][0,0,0]+=1
