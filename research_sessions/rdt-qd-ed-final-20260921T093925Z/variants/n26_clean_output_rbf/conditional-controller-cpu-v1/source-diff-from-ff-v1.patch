+        and not any(k.startswith(('n7_','n9_','n11_','n17_','n18_','n19_','n20_','n21_','n22_','n23_','n24_','n25_')) for k in plan),
+        'N26 closed prospective matrix/phase differs')
+    for arm in ('N25','N26'):
