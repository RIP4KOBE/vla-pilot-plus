@@ -0,0 +1,101 @@
+"""N24 envelope around the unchanged exact Codex-timeout classifier."""
+from pathlib import Path
+import types
+from scripts import qd_ed_n23_worker as w
+from scripts import qd_ed_n24_contract as c
+from scripts import qd_ed_n24_native as native
+
+
+def classifier():
+    from scripts import qd_ed_n23_v2_recovery
+    return qd_ed_n23_v2_recovery
+
+
+def terminal_binding(final,row,plan,reference,r):
+    classifier().terminal_binding(final,row,plan,reference,r)
+
+
+def check_cell_history(events,row,primary_id,r):
+    local=[e for e in events if e.get('identity',{}).get('iteration')==c.COHORT]
+    groups=r['event_groups'](local)
+    own=[g for g in groups.values() if g[0].get('episode_key')==row['episode_key']]
+    w.require(len(own)==1 and own[0][0]['attempt_id']==primary_id
+        and [e['event'] for e in own[0]]==['reserved','dispatched','valid']
+        and own[0][-1].get('outcome_valid') is False and all(e.get('retry_of') is None for e in own[0])
+        and own[0][0]['identity']==r['episode_identity'](row), 'N24 recovery requires one completed invalid primary')
+    w.require(len({e['attempt_id'] for e in local if e.get('retry_of')})<2,'N24 recovery slots exhausted')
+    return own[0][-1]
+
+
+
+def diagnose(final,row,profile,runtime,r,report):
+    """Private evidence-reader substitution only; all original timeout gates stay exact."""
+    original=classifier()
+    path=Path(final['output_dir'])/'eds_eval/eds_metrics.jsonl'
+    if path.is_file():return original.diagnose(final,row,profile,runtime,r,native_report=report)
+    w.require(type(final.get('guided_chunks')) is int and final['guided_chunks']==0,
+        'N24 absent metric recovery needs explicit terminal guided zero')
+    counts,_=native.from_output(row['profile'],final['output_dir'],report,0)
+    w.require(counts['guided_decisions']==0,'N24 absent metric recovery native count differs')
+    def evidence_files(output):
+        output=Path(output)
+        mapping={'stage_events':'eds_eval/stage_events.jsonl','episode_compute':'eds_eval/episode_compute.jsonl',
+            'episode_metadata':'eds_eval/episode_metadata.jsonl','safety_events':'eds_eval/safety_events.jsonl',
+            'metrics':'eds_eval/eds_metrics.jsonl','resolved_config':'.hydra/config.yaml','results':'results.txt'}
+        result={}
+        for key,name in mapping.items():
+            item=output/name
+            if key in {'safety_events','metrics'}:
+                w.require(not item.is_symlink() and (item.is_file() or not item.exists()),'N24 optional evidence unsafe')
+                if key=='metrics':w.require(not item.exists(),'N24 absent metrics changed during classification')
+                result[key]={'path':str(item.resolve()),'present':item.is_file(),'sha256':w.sha(item) if item.is_file() else None}
+            else:result[key]=c.ref(item)
+        return result
+    fn=original.diagnose
+    private=types.FunctionType(fn.__code__,{**fn.__globals__,'evidence_files':evidence_files},fn.__name__,fn.__defaults__,fn.__closure__)
+    private.__kwdefaults__=fn.__kwdefaults__
+    return private(final,row,profile,runtime,r,native_report=report)
+
+def create_eligibility(plan_path,plan,row,final,profile,runtime,events,root,r):
+    w.require(row in plan['episodes'] and row['iteration']==c.COHORT,'N24 recovery primary identity differs')
+    w.require(check_cell_history(events,row,final['attempt_id'],r)==final,'N24 primary terminal journal differs')
+    terminal_binding(final,row,plan,c.ref(plan_path),r)
+    output=Path(final['output_dir']);terminal=c.ref(output/'attempt-result.json')
+    w.require(w.read_ref(terminal)==final and final.get('n23_worker_receipt')==c.ref(output/'eds_eval/in-worker-audit-receipt.json'),
+        'N24 primary terminal/metered audit differs')
+    report=c.read_worker_report(output,r)
+    w.require(type(final.get('guided_chunks')) is int,'N24 terminal guided count missing')
+    native.from_output(row['profile'],output,report,final['guided_chunks'])
+    diagnostic=diagnose(final,row,profile,runtime,r,report)
+    return {'schema':'n24-typed-timeout-eligibility-v1','cohort_id':c.COHORT,'primary_attempt_id':final['attempt_id'],
+        'episode_key':row['episode_key'],'scientific_row':row,'plan':c.ref(plan_path),'source_commit':plan['source_commit'],
+        'protocol':c.ref(c.PROTOCOL),'timeout_observability':c.ref(c.OBSERVABILITY),'terminal':terminal,
+        'native_receipt':c.ref(output/'eds_eval/in-worker-audit-receipt.json'),
+        'native_report':c.ref(output/'eds_eval/decision-evidence-audit.json'),'process':c.ref(output/'process.json'),
+        'evidence_files':diagnostic['evidence_files'],'diagnostic':diagnostic,
+        'evidence_packaging_reader':c.ref(__file__),
+        'evidence_packaging_mode':('n24_absent_zero_guided_private_reader' if not (output/'eds_eval/eds_metrics.jsonl').exists() else 'unchanged_original_reader'),
+        'primary_outcome_valid':False,'unknown_token_calls':1,'retry_budget_bucket':'recovery','same_cell_max_recoveries':1}
+
+
+def verify_eligibility(reference,plan,row,events,root,r):
+    record=w.read_ref(reference)
+    w.require(record.get('schema')=='n24-typed-timeout-eligibility-v1' and record.get('cohort_id')==c.COHORT
+        and record.get('episode_key')==row['episode_key'] and record.get('scientific_row')==row
+        and record.get('source_commit')==plan['source_commit'] and w.read_ref(record['plan'])==plan,
+        'N24 eligibility plan/source differs')
+    final=check_cell_history(events,row,record['primary_attempt_id'],r)
+    manifest=r['read_json'](plan['profiles_path'])
+    for arm,profile in plan['candidate_profiles'].items():
+        manifest['profiles'][arm]=r['expand_candidate'](arm,w.read_ref(profile),manifest['profiles']['Q0'])
+    runtime=w.read_ref({'path':plan['runtime_manifest_path'],'sha256':plan['runtime_manifest_sha256']})
+    rebuilt=create_eligibility(record['plan']['path'],plan,row,final,manifest['profiles'][row['profile']],runtime,events,root,r)
+    w.require(record==rebuilt,'N24 eligibility changed or widened')
+    return record
+
+
+def check_retry(events,row,r):
+    reference=row['n24_recovery_eligibility'];record=w.read_ref(reference);plan=w.read_ref(record['plan'])
+    primary=c.primary_row(plan,row)
+    w.require(row.get('retry_of')==record['primary_attempt_id'] and row['budget_bucket']=='recovery','N24 retry lineage/bucket differs')
+    verify_eligibility(reference,plan,primary,events,Path(plan['worktree']),r)
diff --git a/scripts/qd_ed_n24_report.py b/scripts/qd_ed_n24_report.py
new file mode 100644
index 0000000..b2eb4ed
--- /dev/null
+++ b/scripts/qd_ed_n24_report.py
@@ -0,0 +1,113 @@
+"""Immutable N24 terminal reconstruction from its own journal and metered receipts."""
+import math
+from pathlib import Path
+from scripts import qd_ed_n23_worker as w
+from scripts import qd_ed_n24_contract as c
+from scripts import qd_ed_n24_native as native
+COST_FIELDS=('gpu_process_wall_seconds','guided_chunks','unguided_chunks','candidate_evaluations','score_batches',
+ 'model_forward_calls','model_batch_rows','reward_calls','reward_evaluations','reward_scoring_batches',
+ 'provider_logical_call_attempts','stage_codex_logical_call_attempts','provider_input_tokens',
+ 'provider_output_tokens','provider_cached_input_tokens','provider_failed_calls')
+
+
+def summary(outcomes,attempts):
+    by={a:{v['task_id']:v['success'] for v in outcomes if v['profile']==a} for a in c.ARMS}
+    costs={a:{k:{'observed_total':0,'observed_attempts':0,'missing_attempts':[]} for k in COST_FIELDS} for a in c.ARMS}
+    unknown=[];unmeasured=[]
+    for item in attempts:
+        final=item['terminal']
+        logical=final.get('provider_logical_call_attempts');complete=final.get('provider_usage_complete_calls')
+        if type(logical) is int and type(complete) is int and 0<=complete<=logical:unknown.append(logical-complete)
+        else:unmeasured.append(item['attempt_id'])
+        for k in COST_FIELDS:
+            v=final.get(k);slot=costs[item['profile']][k]
+            if type(v) in (int,float) and math.isfinite(v) and v>=0:slot['observed_total']+=v;slot['observed_attempts']+=1
+            else:slot['missing_attempts'].append(item['attempt_id'])
+    pairs={}
+    for a in c.ARMS[:-1]:
+        matched=set(by['N24'])&set(by[a]);pairs[a]={'denominator':len(matched),
+            'gains':sum(by['N24'][t] and not by[a][t] for t in matched),
+            'losses':sum(not by['N24'][t] and by[a][t] for t in matched)}
+    return {'accepted_cell_denominators':{a:len(v) for a,v in by.items()},'matched_comparisons':pairs,
+        'primary_attempt_denominators':{a:sum(v['profile']==a and not v['terminal'].get('retry_of') for v in attempts) for a in c.ARMS},
+        'all_attempt_denominators':{a:sum(v['profile']==a for v in attempts) for a in c.ARMS},
+        'all_attempt_costs':costs,'known_unknown_token_calls':sum(unknown),'unknown_token_calls':None if unmeasured else sum(unknown),
+        'unmeasured_token_call_attempts':unmeasured,'all_attempt_token_usage_complete':bool(attempts) and not unmeasured and not sum(unknown)
+            and all(v['terminal'].get('provider_token_usage_complete') is True for v in attempts),
+        'token_cost_interpretation':'observed token totals are partial lower bounds when usage is unknown'}
+
+
+def analyze(plan,events,acceptor):
+    rows=plan['episodes'];keys=[x['episode_key'] for x in rows]
+    w.require(len(rows)==40 and len(set(keys))==40 and [(x['task_id'],x['profile']) for x in rows]==[(t,a) for t in range(10) for a in c.ARMS],
+        'N24 report matrix differs')
+    local=[e for e in events if e.get('identity',{}).get('iteration')==c.COHORT]
+    groups={}
+    for e in local:
+        w.require(e.get('episode_key') in keys,'N24 unknown journal cell')
+        groups.setdefault(e['attempt_id'],[]).append(e)
+    attempts=[];dispatch=0
+    for aid,group in groups.items():
+        w.require(group[0]['event']=='reserved' and group[-1]['event'] in {'valid','aborted'}
+            and sum(e['event']=='dispatched' for e in group)<=1,'N24 report unsettled or malformed journal')
+        final=group[-1];row=rows[keys.index(final['episode_key'])]
+        dispatch+=sum(e['event']=='dispatched' for e in group)
+        attempts.append({'attempt_id':aid,'episode_key':row['episode_key'],'profile':row['profile'],'terminal':final})
+    accepted=[];failure=None;seen=[];native_counts={a:{} for a in c.ARMS};aux={a:{} for a in c.ARMS}
+    for row in rows:
+        own=[g for g in groups.values() if g[0]['episode_key']==row['episode_key']]
+        if not own:break
+        try:cell,counts,cost=acceptor(row,local)
+        except (ValueError,RuntimeError,OSError,KeyError,AssertionError) as exc:
+            failure={'episode_key':row['episode_key'],'reason':str(exc),'failure_class':type(exc).__name__};break
+        accepted.append(cell);seen.append(row['episode_key'])
+        for k,v in counts.items():native_counts[row['profile']][k]=native_counts[row['profile']].get(k,0)+v
+        for k,v in cost.items():aux[row['profile']][k]=aux[row['profile']].get(k,0)+v
+    allowed=set(seen)|({rows[len(seen)]['episode_key']} if len(seen)<40 else set())
+    w.require(all(e['episode_key'] in allowed for e in local),'N24 journal skips or continues past invalid cell')
+    counts={a:{'audited':sum(v['profile']==a for v in accepted),'success':sum(v['profile']==a and v['success'] for v in accepted)} for a in c.ARMS}
+    wins=counts['N24']['success'];complete=len(accepted)==40
+    substantive=native_counts['N24'].get('guided_decisions',0)>0 and native_counts['N24'].get('parent_rounds_verified',0)>0
+    promoted=complete and wins>=5 and wins>=max(counts[a]['success'] for a in c.ARMS[:-1]) and substantive
+    futility=len(accepted)%4==0 and wins+10-len(accepted)//4<5
+    decision=('ELIGIBLE_FOR_SEPARATELY_FROZEN_VALIDATION' if promoted else 'REJECT' if complete else
+              'REJECT_NUMERIC_FUTILITY' if futility and failure is None else 'INVALID_OR_INTERRUPTED')
+    return {'schema':'n24-dev-cohort-result-v1','cohort_id':c.COHORT,'source_commit':plan['source_commit'],
+        'planned':40,'dispatched':dispatch,'audited_cells':len(accepted),'counts':counts,'accepted_cells':accepted,
+        'attempts':attempts,'native':native_counts,'auxiliary':aux,'dev_gate_promoted':promoted,'decision':decision,
+        'failure':failure,'goal_status':'TARGET_NOT_MET','validation_authorized':False,'formal_authorized':False,
+        'mechanism_interpretation':'cache and substitution counts are descriptive, never a positive-count promotion veto',
+        **summary(accepted,attempts)}
+
+
+def write_terminal(plan_path,plan,status_path,root,r):
+    try:status=w.read_ref(c.ref(status_path));status_ref=c.ref(status_path)
+    except (OSError,ValueError,KeyError) as exc:
+        status={'status':'unavailable','failure_class':type(exc).__name__};status_ref={'path':str(Path(status_path).resolve()),'sha256':None}
+    events=r['read_events'](Path(root)/'data/attempt-ledger.jsonl')
+    local=[e for e in events if e.get('identity',{}).get('iteration')==c.COHORT]
+    def accept(row,events):
+        final=c.accepted_cell(plan,row,events,root,r);output=Path(final['output_dir'])
+        report=c.read_worker_report(output,r);counts,aux=native.from_output(row['profile'],output,report,final.get('guided_chunks'))
+        return {'episode_key':row['episode_key'],'task_id':row['task_id'],'profile':row['profile'],
+            'attempt_id':final['attempt_id'],'success':final['success'],'audit':c.ref(output/'eds_eval/decision-evidence-audit.json'),
+            'worker_context':c.ref(output/'n23-worker-context.json'),'worker_receipt':c.ref(output/'eds_eval/in-worker-audit-receipt.json'),
+            'attempt_result':c.ref(output/'attempt-result.json')},counts,aux
+    result=analyze(plan,local,accept)
+    journal_prefix=[x['episode_key'] for x in result['accepted_cells']]
+    consistent=(status.get('completed_keys')==journal_prefix and status.get('dev_gate_promoted')==result['dev_gate_promoted'])
+    phase=status.get('status')
+    consistent=consistent and ((phase=='rejected_numeric_futility' and result['decision']=='REJECT_NUMERIC_FUTILITY')
+        or (phase=='completed_all_forty_audited' and result['audited_cells']==40)
+        or (phase in {'failed','interrupted'} and result['decision']=='INVALID_OR_INTERRUPTED'))
+    result['controller_evidence']={'completed_keys':status.get('completed_keys'),'journal_accepted_keys':journal_prefix,
+        'consistent':consistent,'status_phase':phase}
+    if not consistent:
+        result['journal_reconstructed_disposition']=result['decision']
+        result['decision']='INVALID_OR_INTERRUPTED';result['dev_gate_promoted']=False
+        result['controller_evidence']['disagreement']='Controller status and independently reconstructed journal differ; no resume or promotion.'
+    snapshot=c.RUN_DIR/'execution/terminal-ledger-v1.json';w.atomic_json(snapshot,local)
+    result.update(plan=c.ref(plan_path),terminal_status={**status_ref,'content':status},ledger_snapshot=c.ref(snapshot),
+        reader=c.ref(Path(root)/'scripts/qd_ed_n24_report.py'),source_bridge=c.ref(c.BRIDGE))
+    w.atomic_json(c.RUN_DIR/'result-v1.json',result)
+    return result
