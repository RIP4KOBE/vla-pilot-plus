+def test_parent_operator_support_bytes_rng_and_no_extra_calls(stub_steer,stub_adapter,monkeypatch,dtype,case):
+    from core.qd_parent_before_renoise import mutate, ParentWitness, INPUT
+    origins=setup(stub_steer,stub_adapter,monkeypatch);cfg=config(stub_steer,'N28')
+    values=input_tensor(dtype,16)
+    if case=='mixed':
+        values[0,:8,39:42]=2;values[1,:8,39:42]=-1
+        values[2,0,39]=-0.0
+    elif case in {'coincident','zero'}:values[:,:8,39:42]=0.25 if case=='coincident' else -0.0
