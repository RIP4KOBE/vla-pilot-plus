+             mask_gradient=stub_steer._mask_guidance_gradient,witness=w,iteration=0,parent_allocation_sequence=None)
+    assert values.stride()==stride and bytes_equal(values[:,8:],saved[:,8:])
+    other=[k for k in range(128) if k not in (39,40,41)]
+    assert bytes_equal(values[:,:,other],saved[:,:,other])
+    unsupported=(saved[:,:8,39:42]<=-1)|(saved[:,:8,39:42]>=1)
+    assert bytes_equal(values[:,:8,39:42][unsupported],saved[:,:8,39:42][unsupported])
