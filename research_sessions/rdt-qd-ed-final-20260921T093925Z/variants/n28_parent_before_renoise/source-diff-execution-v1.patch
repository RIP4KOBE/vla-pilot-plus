+    w.require(saved[0][0]=='n28_rbf_witness' and saved[1][0]=='n28_parent_renoise_input'
+        and exact(boundary['prefix'],capture['parent_offspring_after']) and boundary['metadata']['same_tensor_object_verified'] is True,
+        'N28 synthetic boundary observer binding differs')
+    w.require(len(steer.origin_calls)==16 and parent.stride()==LAYOUTS[layout][0]
+        and parent.storage_offset()==LAYOUTS[layout][1],'N28 projector/layout changed')
+    result=audit_witness(capture,metadata,backend)
+    if case=='strict_interior':
+        raw=reconstruct(capture['input_xyz'],backend.native(origins),input_stride=list(parent.stride()),clipped=False)
+        w.require(exact(capture['gradient_after'],raw['gradient_after']),'N28 interior geometry differs')
+    unsupported=(capture['input_xyz']<=-1)|(capture['input_xyz']>=1)
+    w.require(torch.count_nonzero(capture['gradient_before'][unsupported])==0,'N28 custom derivative support differs')
+    rejected=[]
+    for name in ('input_xyz','projected_xyz','gradient_before','gradient_after','update_operand','parent_offspring_before','parent_offspring_after'):
+        bad={k:v.clone() for k,v in capture.items()};v=bad[name]
+        v[0,0,0]=torch.nextafter(v[0,0,0],torch.tensor(float('inf'),dtype=v.dtype,device=v.device))
+        try:audit_witness(bad,metadata,backend)
+        except ValueError:rejected.append(name)
+    w.require(len(rejected)==7,'N28 finite corruption accepted')
+    bad={k:v.clone() for k,v in capture.items()};bad['input_xyz'][0,0,0]=0.;bad['parent_offspring_before'][0,0,0]=-0.
+    signed=False
+    try:audit_witness(bad,metadata,backend)
+    except ValueError:signed=True
