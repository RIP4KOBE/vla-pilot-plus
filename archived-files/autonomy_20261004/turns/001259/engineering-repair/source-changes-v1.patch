+DATA_STOP = '/mnt/data/shared2/hynx/VLA-Pilot++/rdt-qd-ed-final-20260921T093925Z/autonomy_20261004/STOP'
+STOP_PATHS = (OWNER_STOP, DATA_STOP)
+DEADLINE = '2026-10-11T11:13:13Z'
+
+
